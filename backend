<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bluetek – Catalogue & Détails Produit</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root{--primary:#0059c7;--primary-d:#034aa4;--accent:#00bcd4;--danger:#e53935;--bg:#f2f5fb;--txt:#202124;--sidebar:#ffffff}
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Poppins',sans-serif;background:var(--bg);color:var(--txt);scroll-behavior:smooth}
    img{display:block;max-width:100%}
    a{color:inherit;text-decoration:none}
    /* layout */
    .wrapper{display:flex;min-height:100vh}
    aside{width:220px;background:var(--sidebar);box-shadow:2px 0 8px rgba(0,0,0,.05);position:sticky;top:0;height:100vh;overflow:auto;z-index:15}
    aside h2{padding:1rem;font-size:1rem;font-weight:700;color:#fff;background:var(--primary)}
    .cat-list{list-style:none}
    .cat-list li{border-bottom:1px solid #eee}
    .cat-list a{display:block;padding:.65rem 1rem;font-size:.9rem;font-weight:500;cursor:pointer}
    .cat-list a.active,.cat-list a:hover{background:var(--bg);color:var(--primary)}
    main{flex:1;display:flex;flex-direction:column;min-height:100vh}
    header{background:#fff;box-shadow:0 2px 6px rgba(0,0,0,.06);position:sticky;top:0;z-index:20}
    .nav-container{max-width:1200px;margin:auto;padding:0 1rem;display:flex;align-items:center;justify-content:space-between;height:60px}
    .logo{display:flex;align-items:center;gap:.5rem;font-weight:700;font-size:1.3rem;color:var(--primary)}
    .logo img{width:30px;height:30px}
    .menu-links{display:flex;gap:1rem;font-size:.9rem;font-weight:500}
    .cart-btn{position:relative;background:none;border:none;font-size:1.4rem;cursor:pointer;color:var(--primary)}
    .cart-count{position:absolute;top:-6px;right:-10px;background:var(--danger);color:#fff;font-size:.7rem;border-radius:50%;padding:0 6px;font-weight:700}
    .hero{background:url('https://images.unsplash.com/photo-1527443154391-507e9dc6c5cc?auto=format&fit=crop&w=1500&q=80') center/cover fixed;height:200px;display:flex;align-items:center;justify-content:center;color:#fff;text-shadow:0 2px 6px rgba(0,0,0,.4);font-size:2rem;font-weight:700}
    section{scroll-margin-top:70px}
    .content{max-width:1200px;margin:auto;width:100%;padding:2rem 1rem}
    .section-title{font-size:1.3rem;font-weight:700;margin-bottom:1rem;color:var(--primary);text-transform:uppercase}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1.2rem}
    .card{background:#fff;border-radius:10px;overflow:hidden;box-shadow:0 4px 10px rgba(0,0,0,.05);display:flex;flex-direction:column;transition:.25s;cursor:pointer}
    .card:hover{transform:translateY(-5px);box-shadow:0 8px 16px rgba(0,0,0,.1)}
    .card-header{position:relative}
    .card-header img{width:100%;height:160px;object-fit:cover;background:#f9f9f9}
    .badge{position:absolute;top:10px;left:10px;background:var(--primary);color:#fff;font-size:.7rem;padding:2px 6px;border-radius:4px;font-weight:600}
    .badge.sale{background:var(--danger)}.badge.out{background:#616161}
    .info{padding:1rem;flex:1;display:flex;flex-direction:column}
    .info h3{font-size:1rem;font-weight:600;min-height:38px}
    .price-tag{margin-top:.3rem;font-weight:700;color:var(--primary)}
    #detail{display:none;max-width:1000px;margin:auto;padding:2rem 1rem}
    #detail.active{display:block}
    .detail-wrapper{display:flex;flex-direction:column;gap:2rem}
    .detail-price{font-size:1.4rem;font-weight:700;color:var(--primary);margin:1rem 0}
    .back-link{display:inline-block;margin-bottom:1rem;color:var(--primary);font-weight:600}
    #add-form{margin:2rem 0;display:flex;flex-wrap:wrap;gap:.6rem}
    #add-form input,#add-form select{flex:1 1 180px;padding:.5rem;border:1px solid #ccc;border-radius:6px}
    #add-form button{padding:.6rem 1rem;border:none;border-radius:6px;background:var(--primary);color:#fff;font-weight:600;cursor:pointer}
    #cart-modal{position:fixed;top:0;right:0;width:320px;height:100vh;background:#fff;box-shadow:-2px 0 8px rgba(0,0,0,.15);transform:translateX(100%);transition:.3s ease;display:flex;flex-direction:column;z-index:30}
    #cart-modal.open{transform:translateX(0)}
    #cart-modal header{background:var(--primary);color:#fff;padding:1rem;font-weight:700;display:flex;justify-content:space-between;align-items:center}
    .cart-items{flex:1;overflow:auto}
    .cart-item{display:flex;justify-content:space-between;padding:.7rem 1rem;border-bottom:1px solid #f1f1f1;font-size:.9rem}
    .cart-actions{padding:1rem;border-top:1px solid #eee;display:flex;gap:.6rem}
    .cart-actions button{flex:1;padding:.65rem;border:none;border-radius:6px;font-weight:600;cursor:pointer}
    .checkout{background:var(--accent);color:#fff}.clear{background:var(--danger);color:#fff}
    footer{background:#fff;padding:1rem;text-align:center;font-size:.8rem;color:#555;box-shadow:0 -2px 4px rgba(0,0,0,.04);margin-top:auto}
    @media(min-width:800px){.detail-wrapper{flex-direction:row}}
    @media(max-width:850px){aside{display:none}header .nav-container{justify-content:space-between}}
  </style>
</head>
<body>
<div class="wrapper">
  <aside>
    <h2>Catalogue</h2>
    <ul class="cat-list" id="cat-list"></ul>
  </aside>
  <main>
    <header>
      <div class="nav-container">
        <a class="logo" href="#home"><img src="https://raw.githubusercontent.com/aimeassamoidesire-maker/nj/main/bluetek_logo.png" alt="Bluetek">Bluetek</a>
        <nav class="menu-links"><a href="#home">Accueil</a><a href="#products">Produits</a><a href="#about">À propos</a><a href="#contact">Contacts</a></nav>
        <button id="cart-button" class="cart-btn">🛒<span id="cart-count" class="cart-count">0</span></button>
      </div>
    </header>
    <section id="home" class="hero">La Tech au meilleur prix</section>
    <section id="products" class="content">
      <h3 class="section-title">Nouveautés</h3>
      <form id="add-form"><input id="name" placeholder="Nom produit"><input id="price" type="number" placeholder="Prix"><input id="img" placeholder="URL image"><select id="cat"><option>Cartes Graphiques</option><option>Moniteurs</option><option>Processeurs</option><option>Stockage</option><option>Périphériques</option><option>Accessoires</option></select><button>Ajouter (demo)</button></form>
      <div id="product-grid" class="grid"></div>
    </section>
    <section id="detail"></section>
    <section id="about" class="content"><h3 class="section-title">À propos</h3><p>Bluetek est une boutique ivoirienne…</p></section>
    <section id="contact" class="content"><h3 class="section-title">Contacts</h3><p>📞 05 74 37 31 45 / 01 02 71 52 83</p></section>
    <footer>© 2025 Bluetek – Tous droits réservés</footer>
  </main>
</div>
